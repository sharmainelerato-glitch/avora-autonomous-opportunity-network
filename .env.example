# Copy to .env. Demo browsing and local workflows work without secrets.
APP_BASE_URL=http://127.0.0.1:8000
LAPENG_DB=avora.sqlite3
# Set a random 32+ character secret before any public deployment.
APP_SECRET=replace-with-long-random-secret
# Groq OpenAI-compatible API for real model-generated agent analysis.
# Leave key blank for accurately labeled deterministic fallback.
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=openai/gpt-oss-120b
# Optional: enable in production only after HTTPS, abuse controls, legal review.
ALLOW_DEMO_ACCOUNTS=true

NEAR_TESTNET_RPC=https://rpc.testnet.near.org

# Optional integrations (leave blank if unused)
EASYPOST_API_KEY=
AVORA_VERIFICATION_OPERATOR_TOKEN=
# Alternative to AI_API_KEY (do not set both unless needed)
GROQ_API_KEY=
